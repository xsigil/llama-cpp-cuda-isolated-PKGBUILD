[Unit]
Description=Stateless Isolated Llama.cpp Inference Server
After=network.target

[Service]
Type=exec
ExecStart=/usr/lib/llama-cpp-isolated/run_server.sh
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s

ProtectControlGroups=yes
ProtectKernelModules=yes

[Install]
WantedBy=multi-user.target
